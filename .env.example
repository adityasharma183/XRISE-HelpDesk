# ==============================================================================
# XRISEAI MINI HELPDESK — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5001


# Client Configuration (CORS & Auth Cookie Domain)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas Cloud Cluster SRV Format)
# Replace with your actual MongoDB Atlas cluster credentials and database name:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/mini_helpdesk?retryWrites=true&w=majority

# Authentication (JWT & Cookies)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=7d
COOKIE_NAME=helpdesk_auth_token

# Google Gemini AI Provider (Optional for basic helpdesk, required for AI reply draft)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
